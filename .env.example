# GPT Image Panel environment template
# Copy to .env before running Docker Compose, then change only what you need.
# Boolean values accept true/false, 1/0, yes/no, on/off.
# Secret fields in Web Settings prefer ${ENV_VAR_NAME} references; storing literal secrets
# in SQLite requires ALLOW_PLAINTEXT_SECRETS=true.

# -- Default upstream API preset ----------------------------------
# Pre-fill the Settings API base URL. It may omit or include /v1.
DEFAULT_API_URL=
# Pre-fill the API key. Prefer saving an env ref in Web Settings, for example ${OPENAI_API_KEY}.
DEFAULT_API_KEY=
# Default upstream route: /v1/images/generations, /v1/responses, or /v1/chat/completions.
DEFAULT_API_PATH=/v1/images/generations
# Fallback top-level model for /v1/responses when a request/preset does not provide one.
DEFAULT_RESPONSES_MODEL=gpt-5.4
# Optional global SOCKS5 proxy for generation/edit upstream calls. Prefer an env ref.
DEFAULT_UPSTREAM_SOCKS5_PROXY=
# aiohttp connector total connection limit for upstream/download/probe calls.
AIOHTTP_CONNECTION_LIMIT=100
# aiohttp connector per-host connection limit. Set 0 to disable the per-host cap.
AIOHTTP_CONNECTION_LIMIT_PER_HOST=20

# -- App version / update check / observability -------------------
# Optional version override shown by /api/version and the UI; leave empty to read VERSION.
APP_VERSION=
# GitHub owner/repo used for latest release checks. Empty disables repo-based update links.
GITHUB_REPO=Z1rconium/gpt-image-linux
# Check latest GitHub release, then fall back to VERSION on VERSION_CHECK_BRANCH.
ENABLE_VERSION_CHECK=true
# Timeout in seconds for each version-check network request.
VERSION_CHECK_TIMEOUT_SECONDS=3
# Branch used for fallback raw VERSION lookup.
VERSION_CHECK_BRANCH=main
# Enable /api/metrics JSON and Prometheus-compatible text output.
ENABLE_METRICS=false
# Log slow /api/gallery queries at or above this threshold in milliseconds.
SLOW_GALLERY_QUERY_MS=200
# Use nginx X-Accel-Redirect for authorized image/thumb/download bytes.
# Docker Compose enables this by default because nginx is in front.
ENABLE_NGINX_ACCEL_REDIRECT=false

# -- Prompt Optimizer ---------------------------------------------
# Enables the server-side prompt rewrite helper.
PROMPT_OPTIMIZER_ENABLED=false
# Full Chat Completions-compatible endpoint URL used only by the optimizer.
PROMPT_OPTIMIZER_API_URL=
# Optimizer API key. Prefer an env ref such as ${OPENAI_API_KEY}.
PROMPT_OPTIMIZER_API_KEY=
# Optimizer model name.
PROMPT_OPTIMIZER_MODEL=gpt-4o-mini
# Optimizer request timeout in seconds.
PROMPT_OPTIMIZER_TIMEOUT_SECONDS=60
# Maximum optimized prompt characters returned to the UI.
PROMPT_OPTIMIZER_MAX_OUTPUT_CHARS=4000
# Maximum optimizer upstream response body size before JSON parsing, in MB.
PROMPT_OPTIMIZER_MAX_RESPONSE_MB=8
# Optional comma-separated hostname allowlist for the optimizer endpoint.
PROMPT_OPTIMIZER_HOST_ALLOWLIST=

# -- Cloudflare R2 Gallery backup sync ----------------------------
# Enables Gallery Sync when R2 is configured from environment/default settings.
R2_BACKUP_ENABLED=false
# S3-compatible R2 endpoint, for example https://ACCOUNT_ID.r2.cloudflarestorage.com.
R2_ENDPOINT_URL=
# R2 bucket used for gallery backup objects.
R2_BUCKET_NAME=
# S3 client region for R2; Cloudflare commonly uses auto.
R2_REGION=auto
# Object key prefix for backup uploads. Use a dedicated prefix like gallery-test/ for validation.
R2_KEY_PREFIX=gallery/
# Scheduled Gallery Sync interval in hours. 0 disables automatic sync.
R2_SYNC_INTERVAL_HOURS=0
# R2 credentials used by env-ref settings.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# -- Access gate / reverse proxy / browser security ---------------
# Required by default. All non-health routes require unlocking with this key.
ACCESS_KEY=
# Set true only when you intentionally want to run without ACCESS_KEY.
# Startup logs a warning because all non-health API routes are unauthenticated.
ALLOW_UNAUTHENTICATED=false
# Access session cookie name.
ACCESS_KEY_COOKIE_NAME=gpt_image_access
# Keep true behind HTTPS. Set false only for plain-HTTP local/private deployments.
ACCESS_COOKIE_SECURE=true
# Failed access attempts before lockout.
ACCESS_MAX_FAILURES=5
# Lockout duration after too many failed access attempts, in seconds.
ACCESS_LOCKOUT_SECONDS=300
# Optional comma-separated allowed client IPs/CIDRs.
IP_ALLOWLIST=
# Trust reverse-proxy headers such as X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY_HEADERS=false
# Optional comma-separated proxy IPs/CIDRs allowed to provide trusted proxy headers.
TRUSTED_PROXY_IPS=
# Canonical browser origin, for example https://panel.example.com. Also helps Host/CSRF checks.
PUBLIC_ORIGIN=
# Optional comma-separated Host / X-Forwarded-Host allowlist. Accepts hostnames, host:port, or origins.
ALLOWED_HOSTS=
# Reject cross-origin POST/PATCH/DELETE requests via Origin/Referer/Sec-Fetch-Site checks.
CSRF_ORIGIN_CHECK_ENABLED=true
# Optional comma-separated host allowlist for upstream generation/edit API URLs.
# With a SOCKS5 upstream proxy, the proxy becomes the trust boundary for remote DNS/network reachability.
UPSTREAM_HOST_ALLOWLIST=
# Optional comma-separated host allowlist for webhook callback URLs.
WEBHOOK_HOST_ALLOWLIST=

# -- Secret persistence / webhooks --------------------------------
# Allow literal API keys, SOCKS5 proxy URLs, webhook URLs, and R2 credentials in SQLite.
ALLOW_PLAINTEXT_SECRETS=false
# Required when a global Webhook URL is configured; used for X-Webhook-Signature.
WEBHOOK_SIGNING_SECRET=
# Webhook delivery timeout per attempt, in seconds.
WEBHOOK_TIMEOUT_SECONDS=5
# Maximum webhook delivery attempts.
WEBHOOK_MAX_ATTEMPTS=3

# -- Upload, import, image, and upstream response limits ----------
# Max uploaded edit-source/imported/downloaded image size, in MB.
MAX_FILE_SIZE_MB=50
# Max JSON request body size for non-upload API calls, in MB.
MAX_JSON_BODY_MB=1
# Max upstream JSON/SSE response body size before parsing, in MB.
MAX_UPSTREAM_JSON_MB=128
# Max decoded image pixels accepted by Pillow.
MAX_IMAGE_PIXELS=100000000
# Max uploaded ZIP size for gallery import, in MB.
IMPORT_ARCHIVE_MAX_MB=1000
# Max number of files inside one import archive.
IMPORT_MAX_FILES=500
# Max total uncompressed import archive size, in MB.
IMPORT_MAX_UNCOMPRESSED_MB=1024
# Max import metadata.json size, in bytes.
IMPORT_MAX_METADATA_BYTES=2097152
# Max uncompressed/compressed ratio for imported files.
IMPORT_MAX_COMPRESSION_RATIO=100

# -- Job queue / SSE limits ---------------------------------------
# Max generation/edit jobs running at the same time.
MAX_ACTIVE_GENERATE_JOBS=2
# Max additional queued generation/edit jobs before new requests return 429.
MAX_QUEUED_GENERATE_JOBS=20
# Max pending edit source image bytes, in MB. Set 0 to disable this cap.
MAX_PENDING_EDIT_SOURCE_MB=200
# Max active SSE subscribers across the whole process.
MAX_SSE_SUBSCRIBERS_GLOBAL=200
# Max active SSE subscribers per client IP.
MAX_SSE_SUBSCRIBERS_PER_IP=10
# Maximum lifetime for one SSE connection, in seconds.
SSE_CONNECTION_TTL_SECONDS=3600

# -- Runtime storage paths ----------------------------------------
# Local generated image directory. In Docker Compose this maps to ./images by default.
IMAGES_DIR=./images
# Thumbnail directory; keep under IMAGES_DIR unless you also adjust volumes/backups.
THUMBNAILS_DIR=./images/thumbs
# Max thumbnail width/height in pixels.
THUMBNAIL_MAX_SIDE=512
# Runtime data directory. In Docker Compose this maps to ./data by default.
DATA_DIR=./data
# SQLite database path for settings, gallery metadata, and job history.
DATABASE_FILE=./data/app.sqlite3

# -- Docker build images ------------------------------------------
# Override these if Docker Hub is slow or blocked.
PYTHON_BASE_IMAGE=python:3.11-slim
NODE_BASE_IMAGE=node:24-alpine
